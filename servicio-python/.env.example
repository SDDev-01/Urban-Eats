# Copie este archivo como .env y complete los valores.
# Base de datos compartida con Spring Boot (XAMPP: root sin contrasena)
DB_URL=mysql+pymysql://root:@localhost:3306/urbaneats?charset=utf8mb4

# Debe ser la MISMA clave que PYTHON_API_KEY en el .env de Spring Boot
API_KEY=

# IA local (Ollama). Modelos sugeridos: qwen3:4b-instruct (recomendado, sin 'razonamiento'), llama3.2:3b (mas rapido)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# 0 = solo CPU (mas rapido en portatiles con GPU pequena); vacio = Ollama decide
OLLAMA_CAPAS_GPU=0

# Rutas por calles: API key gratis en https://openrouteservice.org (sin tarjeta)
ORS_API_KEY=

# Modo demostracion: habilita los scripts de reinicio de datos de prueba
MODO_DEMO=true
