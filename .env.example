# Copie este archivo como .env y complete los valores (el .env NO se sube a GitHub)

# Base de datos (XAMPP local: usuario root sin contrasena)
DB_URL=jdbc:mysql://localhost:3306/urbaneats?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# MercadoPago: credenciales de PRUEBA (panel de desarrolladores > credenciales de prueba)
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# Servicio Python (FastAPI). La misma clave debe ir como API_KEY en servicio-python/.env
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_API_KEY=

# Modo demostracion (true solo para la sustentacion): franja visible y pedidos fuera de horario
MODO_DEMO=false
# Pagos simulados sin MercadoPago. Nunca en true en un despliegue real.
PAGOS_MODO_DEMO=false
